{
	"name": "socket-io-chat-app",
	"version": "2.0.0",
	"description": "Real-time chat application with Express, Socket.IO, and React",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k \"tsx server/index.ts\" \"vite\"",
		"build": "vite build && tsc -p tsconfig.server.json",
		"start": "node dist/server/index.js",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix ."
	},
	"dependencies": {
		"express": "^5.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"concurrently": "^10.0.7",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.8",
		"prettier": "^3.10.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	}
}
